{
  "name": "devweave-control-center",
  "displayName": "DevWeave Control Center｜開發流程總覽",
  "description": "以繁體中文呈現 DevWeave 檔案快照；工作流程命令交接到 Codex Chat，初始化則需確認固定 bootstrap 寫入。",
  "version": "0.2.3",
  "publisher": "devweave",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "DevWeave",
    "SDLC",
    "Codex",
    "workflow"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:devweave.workItems",
    "onCommand:devweave.openDashboard",
    "onCommand:devweave.initialize",
    "onCommand:devweave.refresh",
    "onCommand:devweave.copyNextAction",
    "onCommand:devweave.wikiBootstrap",
    "workspaceContains:.devweave/project.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devweave",
          "title": "DevWeave",
          "icon": "./media/devweave.svg"
        }
      ]
    },
    "views": {
      "devweave": [
        {
          "id": "devweave.workItems",
          "name": "工作項目",
          "when": "workbenchState != empty"
        }
      ]
    },
    "commands": [
      {
        "command": "devweave.openDashboard",
        "title": "DevWeave: 開啟 Control Center"
      },
      {
        "command": "devweave.initialize",
        "title": "DevWeave: 初始化 workspace"
      },
      {
        "command": "devweave.refresh",
        "title": "DevWeave: 重新整理檔案快照"
      },
      {
        "command": "devweave.copyNextAction",
        "title": "DevWeave: 開啟「詢問下一步」預覽"
      },
      {
        "command": "devweave.wikiBootstrap",
        "title": "DevWeave: 建立 Codebase Wiki（開啟預覽）"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devweave.openDashboard",
          "when": "view == devweave.workItems",
          "group": "navigation@1"
        },
        {
          "command": "devweave.refresh",
          "when": "view == devweave.workItems",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "devweave.initialize",
          "when": "workbenchState != empty"
        },
        {
          "command": "devweave.copyNextAction",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "devweave.wikiBootstrap",
          "when": "workbenchState != empty"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "node esbuild.mjs --production && node scripts/release-orchestrator.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:smoke": "npm run build && tsx test/smoke.test.ts",
    "test:smoke:current": "tsx test/smoke.test.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^22.10.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
