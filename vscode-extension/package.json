{
  "name": "devweave-control-center",
  "displayName": "DevWeave Control Center",
  "description": "以 Codex app-server 驅動具 Gate、approval、verification 與 review 的 DevWeave V2 workflow。",
  "version": "2.0.0",
  "publisher": "devweave",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "keywords": ["DevWeave", "SDLC", "Codex", "workflow"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:devweave.runs",
    "onCommand:devweave.openControlCenter",
    "onCommand:devweave.startRun",
    "onCommand:devweave.resumeRun",
    "workspaceContains:.codex/config.toml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "devweave", "title": "DevWeave", "icon": "./media/devweave.svg" }]
    },
    "views": {
      "devweave": [{ "id": "devweave.runs", "name": "Runs", "when": "workbenchState != empty" }]
    },
    "commands": [
      { "command": "devweave.openControlCenter", "title": "DevWeave: Open Control Center" },
      { "command": "devweave.startRun", "title": "DevWeave: Start Governed Run" },
      { "command": "devweave.resumeRun", "title": "DevWeave: Resume Run" },
      { "command": "devweave.steer", "title": "DevWeave: Steer Active Turn" },
      { "command": "devweave.interrupt", "title": "DevWeave: Interrupt Active Turn" },
      { "command": "devweave.cancel", "title": "DevWeave: Cancel Run" }
    ],
    "menus": {
      "view/title": [
        { "command": "devweave.openControlCenter", "when": "view == devweave.runs", "group": "navigation@1" },
        { "command": "devweave.resumeRun", "when": "view == devweave.runs", "group": "navigation@2" }
      ],
      "commandPalette": [
        { "command": "devweave.openControlCenter", "when": "workbenchState != empty" },
        { "command": "devweave.startRun", "when": "workbenchState != empty" },
        { "command": "devweave.resumeRun", "when": "workbenchState != empty" },
        { "command": "devweave.steer", "when": "workbenchState != empty" },
        { "command": "devweave.interrupt", "when": "workbenchState != empty" },
        { "command": "devweave.cancel", "when": "workbenchState != empty" }
      ]
    },
    "configuration": {
      "title": "DevWeave",
      "properties": {
        "devweave.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used only to launch the repository-local private host bridge."
        },
        "devweave.codexPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute Codex executable path. Empty means resolve Codex from PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "node esbuild.mjs --production && node scripts/release-orchestrator.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:smoke": "npm run build && tsx test/smoke.test.ts",
    "test:smoke:current": "tsx test/smoke.test.ts",
    "evidence:ui": "tsx scripts/ui-evidence.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^22.10.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
