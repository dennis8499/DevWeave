{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -B \"$(git rev-parse --show-toplevel)/.agents/skills/devweave/scripts/guard.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"[Console]::InputEncoding = [System.Text.UTF8Encoding]::new(0); [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(0); py -3 -X utf8 -B (Join-Path (git rev-parse --show-toplevel) '.agents\\skills\\devweave\\scripts\\guard.py')\"",
            "timeout": 30,
            "statusMessage": "Checking DevWeave gates"
          }
        ]
      }
    ]
  }
}
