{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$repo = git rev-parse --show-toplevel; python -B (Join-Path $repo '.agents\\skills\\devweave\\scripts\\guard.py')\"",
            "statusMessage": "Checking DevWeave gates"
          }
        ]
      }
    ]
  }
}
